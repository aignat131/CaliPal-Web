rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }
    function isSuperAdmin() {
      return isAuth() && request.auth.token.superAdmin == true;
    }
    function getCommunityMember(communityId) {
      return get(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid));
    }
    function isCommunityMember(communityId) {
      return isAuth() && exists(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid));
    }
    function getMemberRole(communityId) {
      return getCommunityMember(communityId).data.role;
    }
    function isCommunityAdmin(communityId) {
      return isCommunityMember(communityId) && getMemberRole(communityId) == 'ADMIN';
    }
    function isCommunityStaff(communityId) {
      return isCommunityMember(communityId) &&
        getMemberRole(communityId) in ['ADMIN', 'MODERATOR', 'TRAINER'];
    }
    // Fondator + Antrenor (not Voluntar) — see lib/schedule/permissions.ts
    function isCommunityCoach(communityId) {
      return isCommunityMember(communityId) &&
        getMemberRole(communityId) in ['ADMIN', 'TRAINER'];
    }

    // ── Users ─────────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isAuth();
      allow create: if isOwner(uid)
        && request.resource.data.createdAt == request.time;
      allow update: if (isOwner(uid)
          && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['coins', 'totalWorkouts', 'currentStreak'])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['bio'])
              || (request.resource.data.bio is string && request.resource.data.bio.size() <= 500))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['displayName'])
              || (request.resource.data.displayName is string && request.resource.data.displayName.size() <= 60))
        ) || isSuperAdmin()
        // Allow owner to increment totalTrainings (used when closing a training)
        || (isOwner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalTrainings']))
        // Allow owner to increment coins, totalWorkouts, currentStreak, lastWorkoutDate (gamification)
        || (isOwner(uid) && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['coins', 'totalWorkouts', 'currentStreak', 'lastWorkoutDate', 'activeProgramId', 'completedPrograms']))
        // Allow owner to update cosmetic fields (shop purchases — coins decrement + cosmetic)
        || (isOwner(uid) && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['coins', 'nameColor', 'emojiBadge', 'titleBadge', 'profileFrame', 'proTitle', 'customNickname']));

      match /workouts/{workoutId} {
        allow read: if isAuth();
        allow write: if isOwner(uid);
      }
      match /skills/{skillId} {
        allow read: if isAuth();
        allow write: if isOwner(uid);
      }
      // Earned badge levels (lib/gamification/badgeSync.ts). Levels only go up.
      match /badges/{badgeId} {
        allow read: if isAuth();
        allow create: if isOwner(uid)
          && request.resource.data.level is int
          && request.resource.data.level >= 1 && request.resource.data.level <= 3;
        allow update: if isOwner(uid)
          && request.resource.data.level is int
          && request.resource.data.level > resource.data.level
          && request.resource.data.level <= 3;
        allow delete: if false;
      }
      match /challenge_progress/{challengeId} {
        allow read, write: if isOwner(uid);
      }
      match /community_challenge_progress/{challengeId} {
        allow read, write: if isOwner(uid);
      }
      match /program_enrollments/{enrollmentId} {
        allow read: if isAuth();
        allow write: if isOwner(uid);
      }
      // Friends subcollection — only owner can add friends; either side can unfriend
      match /friends/{friendId} {
        allow read: if isAuth();
        allow create: if isOwner(uid);
        allow delete: if isOwner(uid) || (isAuth() && request.auth.uid == friendId);
      }
    }

    // ── Shop purchases ────────────────────────────────────────────────────────
    match /users/{uid}/purchases/{itemId} {
      allow read: if isAuth();
      allow create: if isOwner(uid);
      allow update, delete: if false;
    }

    // ── Coin tasks (one-time award guards) ────────────────────────────────────
    match /coin_tasks/{taskId} {
      allow read: if isAuth() && (resource == null || resource.data.uid == request.auth.uid);
      allow create: if isAuth()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.awardedAt == request.time;
      allow update, delete: if false;
    }

    // ── Training streak milestone guards ──────────────────────────────────────
    match /training_streak_tasks/{taskId} {
      allow read: if isAuth() && (resource == null || resource.data.uid == request.auth.uid);
      allow create: if isAuth()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.awardedAt == request.time;
      allow update, delete: if false;
    }

    // ── Push / email rate limiting (server-only write via Admin SDK) ─────────
    match /push_rate/{uid} {
      allow read, write: if false; // admin SDK only
    }
    match /email_rate/{uid} {
      allow read, write: if false; // admin SDK only
    }

    // ── FCM tokens ────────────────────────────────────────────────────────────
    match /fcm_tokens/{uid} {
      allow read, write: if isOwner(uid);
    }

    // ── Communities ───────────────────────────────────────────────────────────
    match /communities/{communityId} {
      allow read: if true;
      allow create: if isAuth()
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 80
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 1000
        && request.resource.data.createdAt == request.time
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.joinedCommunityIds.size() < 10;
      allow update: if isCommunityAdmin(communityId) || isSuperAdmin() ||
        (isAuth() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount']));
      allow delete: if isSuperAdmin();

      match /members/{uid} {
        allow read: if true;
        // Joining: role must be MEMBER, except the community creator who joins as ADMIN.
        // Score fields can't be self-seeded.
        allow create: if isOwner(uid)
          && request.resource.data.joinedAt == request.time
          && (request.resource.data.role == 'MEMBER'
              || (request.resource.data.role == 'ADMIN'
                  && get(/databases/$(database)/documents/communities/$(communityId)).data.creatorId == request.auth.uid))
          && !request.resource.data.keys().hasAny(['trainingPoints', 'totalTrainingsAttended'])
          && (!('points' in request.resource.data) || request.resource.data.points == 0);
        // Self-edits (name/photo/notification prefs) can't touch role or score.
        // Staff can update members (attendance points — also used by the Android app),
        // but only the Fondator can change roles.
        allow update: if isSuperAdmin()
          || isCommunityAdmin(communityId)
          || (isOwner(uid)
              && !request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(['role', 'points', 'level', 'trainingPoints', 'totalTrainingsAttended']))
          || (isCommunityStaff(communityId)
              && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']));
        allow delete: if isOwner(uid) || isCommunityAdmin(communityId) || isSuperAdmin();
      }

      // ── Progress: per-community configuration (points, test metrics) ──────
      match /config/{docId} {
        allow read: if isCommunityMember(communityId) || isSuperAdmin();
        allow write: if (isCommunityCoach(communityId) || isSuperAdmin())
          && docId == 'plan'
          && (!('points' in request.resource.data) || (
                request.resource.data.points is map
                && request.resource.data.points.keys().hasOnly(['attendance', 'goalAchieved'])
                && (!('attendance' in request.resource.data.points)
                    || (request.resource.data.points.attendance is int
                        && request.resource.data.points.attendance >= 0
                        && request.resource.data.points.attendance <= 1000))
                && (!('goalAchieved' in request.resource.data.points)
                    || (request.resource.data.points.goalAchieved is int
                        && request.resource.data.points.goalAchieved >= 0
                        && request.resource.data.points.goalAchieved <= 1000))))
          && (!('testIntervalWeeks' in request.resource.data)
              || (request.resource.data.testIntervalWeeks is int
                  && request.resource.data.testIntervalWeeks >= 1
                  && request.resource.data.testIntervalWeeks <= 12))
          && (!('testMetrics' in request.resource.data)
              || (request.resource.data.testMetrics is list
                  && request.resource.data.testMetrics.size() <= 15));
      }

      // ── Progress: per-member plan (goals, exercises, tips, journal, tests) ──
      // Owner writes their own data; Fondator/Antrenor can read it (member file).
      match /memberPlans/{uid} {
        function canReadPlan() {
          return isOwner(uid) || isCommunityCoach(communityId) || isSuperAdmin();
        }
        function ownerWrites() {
          return isOwner(uid) && isCommunityMember(communityId);
        }

        // Goals — "atins" (reward + feed post) goes through the API.
        match /goals/{goalId} {
          allow read: if canReadPlan();
          allow create: if ownerWrites()
            && request.resource.data.status == 'IN_PROGRESS'
            && !request.resource.data.keys().hasAny(['rewarded', 'rewardPoints', 'achievedAt', 'posted'])
            && request.resource.data.skill is string
            && request.resource.data.skill.size() > 0
            && request.resource.data.skill.size() <= 60
            && request.resource.data.currentLevel is string
            && request.resource.data.currentLevel.size() <= 120
            && request.resource.data.target is string
            && request.resource.data.target.size() <= 120
            && request.resource.data.createdAt == request.time;
          allow update: if ownerWrites()
            && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['rewarded', 'rewardPoints', 'achievedAt', 'posted', 'createdAt'])
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
                || request.resource.data.status == 'IN_PROGRESS')
            && request.resource.data.skill is string
            && request.resource.data.skill.size() <= 60
            && request.resource.data.currentLevel.size() <= 120
            && request.resource.data.target.size() <= 120;
          allow delete: if ownerWrites() || isSuperAdmin();
        }

        // Extra exercises — assigned by Fondator/Antrenor; the member only ticks `checks`.
        match /extraExercises/{exerciseId} {
          allow read: if canReadPlan();
          allow create, update: if (isCommunityCoach(communityId) || isSuperAdmin())
            && request.resource.data.name is string
            && request.resource.data.name.size() > 0
            && request.resource.data.name.size() <= 80
            && request.resource.data.sets is int
            && request.resource.data.amount is int
            && request.resource.data.perWeek is int
            && request.resource.data.perWeek >= 1
            && request.resource.data.perWeek <= 14
            && request.resource.data.checks is map;
          allow update: if ownerWrites()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['checks'])
            && request.resource.data.checks is map
            && request.resource.data.checks.size() <= 60;
          allow delete: if isCommunityCoach(communityId) || isSuperAdmin();
        }

        // Weekly journal — one doc per week (id = weekStart).
        match /journal/{weekKey} {
          allow read: if canReadPlan();
          allow write: if ownerWrites()
            && weekKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && request.resource.data.keys().hasOnly(['trainings', 'worked', 'progress', 'notes', 'updatedAt'])
            && request.resource.data.trainings is int
            && request.resource.data.trainings >= 0
            && request.resource.data.trainings <= 21
            && request.resource.data.worked is string && request.resource.data.worked.size() <= 1000
            && request.resource.data.progress is string && request.resource.data.progress.size() <= 1000
            && request.resource.data.notes is string && request.resource.data.notes.size() <= 1000
            && request.resource.data.updatedAt == request.time;
        }

        // Progress tests — one doc per test date (id = yyyy-MM-dd).
        // Coach tips — created by the API (Admin SDK, notifies the member);
        // the member may only mark them seen; Fondator/Antrenor may delete.
        match /tips/{tipId} {
          allow read: if canReadPlan();
          allow create: if false;
          allow update: if ownerWrites()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen'])
            && request.resource.data.seen == true;
          allow delete: if isCommunityCoach(communityId) || isSuperAdmin();
        }

        match /tests/{dateKey} {
          allow read: if canReadPlan();
          allow write: if ownerWrites()
            && dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && request.resource.data.keys().hasOnly(['values', 'updatedAt'])
            && request.resource.data.values is map
            && request.resource.data.values.size() <= 20
            && request.resource.data.updatedAt == request.time;
          allow delete: if ownerWrites();
        }
      }

      // Reminder cooldown bookkeeping — written by the Admin SDK only.
      match /reminders/{docId} {
        allow read: if isCommunityStaff(communityId) || isSuperAdmin();
        allow write: if false;
      }

      match /posts/{postId} {
        allow read: if isAuth();
        allow create: if isCommunityMember(communityId)
          && request.resource.data.content is string
          && request.resource.data.content.size() <= 2000
          && request.resource.data.createdAt == request.time;
        allow update: if isAuth() && (
          request.auth.uid == resource.data.authorId ||
          isCommunityStaff(communityId) ||
          isSuperAdmin() ||
          (isCommunityMember(communityId) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentsCount']))
        );
        allow delete: if isAuth() && (
          request.auth.uid == resource.data.authorId ||
          isCommunityStaff(communityId) ||
          isSuperAdmin()
        );

        match /comments/{commentId} {
          allow read: if isAuth();
          allow create: if isCommunityMember(communityId)
            && request.resource.data.text is string
            && request.resource.data.text.size() <= 1000
            && request.resource.data.createdAt == request.time;
          allow update, delete: if isAuth() && (
            request.auth.uid == resource.data.authorId ||
            isCommunityStaff(communityId) ||
            isSuperAdmin()
          );
        }

        match /likes/{uid} {
          allow read: if isAuth();
          allow write: if isOwner(uid);
        }

        match /reactions/{uid} {
          allow read: if isAuth();
          allow write: if isOwner(uid);
        }
      }

      match /trainings/{trainingId} {
        allow read: if true;
        allow create: if (isCommunityMember(communityId) || isSuperAdmin())
          && !request.resource.data.keys().hasAny(['attendanceAwards'])
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 120
          && request.resource.data.description is string
          && request.resource.data.description.size() <= 1000
          && request.resource.data.createdAt == request.time;
        // Hard delete blocked — only Admin SDK (server-side) can delete
        allow delete: if false;
        // Staff: close training and mark attendees
        // Author: edit own training details
        // Members: update own rsvp + rsvpNames (+ optionally lastRsvpNotifAt in same write)
        // Anyone (incl. guests): update guestRsvps (+ optionally lastRsvpNotifAt), capped at 200
        // NOTE: deletedAt/deletedByUid blocked from ALL clients — soft-delete only via API
        allow update: if (isSuperAdmin()
              && !request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(['deletedAt', 'deletedByUid']))
          || (isCommunityStaff(communityId)
              && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['isClosed', 'attendedBy', 'closedAt', 'closedByUid']))
          // NOTE: attendanceAwards / capacity / source are written by the Admin SDK only
          || (isCommunityMember(communityId)
              && request.auth.uid == resource.data.authorId
              && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['name', 'description', 'timeStart', 'timeEnd']))
          || (isCommunityMember(communityId)
              && !('capacity' in resource.data && resource.data.capacity is int)
              && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['rsvps', 'rsvpNames', 'rsvpPhotos', 'lastRsvpNotifAt']))
          || (isCommunityMember(communityId)
              && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['photoCount', 'commentsCount']))
          || (request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['guestRsvps', 'lastRsvpNotifAt'])
              && request.resource.data.guestRsvps.size() <= 50);
      }

      // Training photos — one per attendee
      match /trainings/{trainingId}/photos/{photoId} {
        allow read: if isAuth() && (
          !('visibility' in resource.data)
          || resource.data.visibility == 'public'
          || request.auth.uid == resource.data.authorId
          || isSuperAdmin()
        );
        allow create: if isCommunityMember(communityId)
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.photoUrl is string
          && request.resource.data.createdAt == request.time;
        allow delete: if isAuth() && (
          request.auth.uid == resource.data.authorId
          || isCommunityStaff(communityId)
          || isSuperAdmin()
        );
        allow update: if false;
      }

      // Training reactions — one per user
      match /trainings/{trainingId}/reactions/{uid} {
        allow read: if isAuth();
        allow write: if isOwner(uid);
      }

      // Training comments — community members can comment
      match /trainings/{trainingId}/comments/{commentId} {
        allow read: if isAuth();
        allow create: if isCommunityMember(communityId)
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 1000
          && request.resource.data.createdAt == request.time;
        allow update, delete: if isAuth() && (
          request.auth.uid == resource.data.authorId ||
          isCommunityStaff(communityId) ||
          isSuperAdmin()
        );
      }

      // Immutable mirror of trainings — no updates, no deletes from any client
      match /trainings_safe/{trainingId} {
        allow read: if true;
        allow create: if (isCommunityMember(communityId) || isSuperAdmin())
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 120
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }

      match /challenges/{challengeId} {
        allow read: if isAuth();
        allow create: if isSuperAdmin() || isCommunityStaff(communityId);
        allow update, delete: if isSuperAdmin() || isCommunityAdmin(communityId);
      }
    }

    // ── Weekly Leaderboard ─────────────────────────────────────────────────────
    // ── Personal-record leaderboard (lib/gamification/badgeSync.ts publishRecords) ──
    match /user_records/{uid} {
      function repsOk(v) { return v is int && v >= 0 && v <= 500; }
      function secsOk(v) { return v is int && v >= 0 && v <= 3600; }
      allow read: if isAuth();
      allow create, update: if isOwner(uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 100
        && repsOk(request.resource.data.pullup)
        && repsOk(request.resource.data.pushup)
        && repsOk(request.resource.data.dips)
        && repsOk(request.resource.data.squat)
        && repsOk(request.resource.data.muscleup)
        && secsOk(request.resource.data.handstand)
        && secsOk(request.resource.data.lsit)
        && secsOk(request.resource.data.plank)
        && secsOk(request.resource.data.front_lever)
        && secsOk(request.resource.data.dead_hang);
      allow delete: if false;
    }

    // ── Friends activity feed (lib/gamification/activity.ts) ───────────────────
    match /activity/{activityId} {
      allow read: if isAuth();
      allow create: if isAuth()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.kind in ['badge', 'record', 'challenge']
        && request.resource.data.name is string && request.resource.data.name.size() <= 100
        && request.resource.data.cheers == {}
        && request.resource.data.createdAt == request.time;
      // Anyone signed in may add/remove only their own cheer
      allow update: if isAuth()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cheers'])
        && request.resource.data.cheers.diff(resource.data.cheers).affectedKeys().hasOnly([request.auth.uid]);
      allow delete: if isAuth() && request.auth.uid == resource.data.uid;
    }

    // ── Friend challenges (lib/gamification/challenges.ts) ─────────────────────
    match /challenges/{challengeId} {
      function lifts() {
        return ['pullup', 'pushup', 'dips', 'squat', 'muscleup',
                'handstand', 'lsit', 'plank', 'front_lever', 'dead_hang'];
      }
      function changes(keys) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
      }
      function isFrom() { return isAuth() && request.auth.uid == resource.data.fromUid; }
      function isTo() { return isAuth() && request.auth.uid == resource.data.toUid; }
      function open() { return request.time < resource.data.deadline; }

      allow read: if isAuth()
        && (request.auth.uid == resource.data.fromUid || request.auth.uid == resource.data.toUid);
      allow create: if isAuth()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.lift in lifts()
        && request.resource.data.target is int
        && request.resource.data.target >= 1 && request.resource.data.target <= 3600
        && request.resource.data.deadline is timestamp
        && request.resource.data.deadline > request.time
        && request.resource.data.deadline < request.time + duration.value(15, 'd')
        && request.resource.data.status == 'PENDING'
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 140;
      allow update: if
        // recipient accepts or declines a pending challenge
        (isTo() && open() && resource.data.status == 'PENDING' && changes(['status'])
          && request.resource.data.status in ['ACCEPTED', 'DECLINED'])
        // recipient completes an accepted challenge before the deadline
        || (isTo() && open() && resource.data.status == 'ACCEPTED'
          && changes(['status', 'result', 'verified', 'completedAt'])
          && request.resource.data.status == 'COMPLETED'
          && request.resource.data.result is int
          && request.resource.data.result >= resource.data.target)
        // challenger withdraws before it's done
        || (isFrom() && resource.data.status in ['PENDING', 'ACCEPTED'] && changes(['status'])
          && request.resource.data.status == 'CANCELLED');
      allow delete: if false;
    }

    match /weekly_leaderboard/{weekId} {
      allow read: if isAuth();
      allow write: if false;

      match /entries/{uid} {
        allow read: if isAuth();
        allow create: if isOwner(uid)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.totalPushupReps is number
          && request.resource.data.totalPushupReps > 0;
        allow update: if isOwner(uid)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.totalPushupReps >= resource.data.totalPushupReps;
        allow delete: if false;
      }
    }

    // ── Direct messages ───────────────────────────────────────────────────────
    match /conversations/{conversationId} {
      function isParticipant() {
        return isAuth() && resource != null && request.auth.uid in resource.data.participantIds;
      }
      allow read: if resource == null || isParticipant();
      allow create: if isAuth()
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.lastMessageTimestamp == request.time;
      allow update: if isParticipant();

      match /messages/{messageId} {
        function convParticipants() {
          let conv = get(/databases/$(database)/documents/conversations/$(conversationId));
          return conv == null ? [] : conv.data.participantIds;
        }
        allow read: if isAuth() && request.auth.uid in convParticipants();
        allow create: if isAuth() &&
          request.auth.uid in convParticipants() &&
          request.auth.uid == request.resource.data.senderId &&
          request.resource.data.text is string &&
          request.resource.data.text.size() <= 4000 &&
          request.resource.data.timestamp == request.time;
        // Allow participants to update messages (e.g. mark as read, add reactions)
        allow update: if isAuth() && request.auth.uid in convParticipants();
        allow delete: if isAuth() && resource.data.senderId == request.auth.uid;
      }

      // Typing indicators — participants can read/write their own typing status
      match /typing/{uid} {
        function typingConvParticipants() {
          let conv = get(/databases/$(database)/documents/conversations/$(conversationId));
          return conv == null ? [] : conv.data.participantIds;
        }
        allow read: if isAuth() && request.auth.uid in typingConvParticipants();
        allow write: if isOwner(uid) && request.auth.uid in typingConvParticipants();
      }
    }

    // ── Friend requests ───────────────────────────────────────────────────────
    match /friend_requests/{requestId} {
      allow read: if isAuth() && (
        resource == null ||
        request.auth.uid == resource.data.fromUid ||
        request.auth.uid == resource.data.toUid
      );
      allow create: if isAuth()
        && request.auth.uid == request.resource.data.fromUid
        && request.resource.data.sentAt == request.time;
      allow update: if isAuth() && (
        request.auth.uid == resource.data.toUid ||
        request.auth.uid == resource.data.fromUid
      );
      allow delete: if isAuth() && (
        request.auth.uid == resource.data.fromUid ||
        request.auth.uid == resource.data.toUid
      );
    }

    // ── Skill category definitions ────────────────────────────────────────────
    match /skillCategories/{categoryId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // ── Parks ─────────────────────────────────────────────────────────────────
    match /parks/{parkId} {
      allow read: if true;
      allow create, delete: if isSuperAdmin();
      allow update: if isSuperAdmin()
        || (isAuth() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['communityId']))
        || (isAuth() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upcomingTrainingCount'])
            && request.resource.data.upcomingTrainingCount >= 0);

      match /trainings/{trainingId} {
        allow read: if true;
        allow create: if isAuth()
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 120
          && request.resource.data.description is string
          && request.resource.data.description.size() <= 1000
          && request.resource.data.createdAt == request.time;
        // Hard delete blocked — only Admin SDK (server-side) can delete
        allow delete: if false;
        // NOTE: deletedAt/deletedByUid blocked from ALL clients — soft-delete only via API
        allow update: if (isSuperAdmin()
              && !request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(['deletedAt', 'deletedByUid']))
          || (isAuth() && request.auth.uid == resource.data.authorId
              && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['name', 'description', 'timeStart', 'timeEnd',
                            'rsvps', 'rsvpNames', 'rsvpPhotos', 'lastRsvpNotifAt']))
          || (isAuth()
              && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['rsvps', 'rsvpNames', 'rsvpPhotos', 'lastRsvpNotifAt']))
          || (request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['guestRsvps', 'lastRsvpNotifAt'])
              && request.resource.data.guestRsvps.size() <= 50);
      }

      // Immutable mirror of trainings — no updates, no deletes from any client
      match /trainings_safe/{trainingId} {
        allow read: if true;
        allow create: if isAuth()
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 120
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    // ── Training backups (safety net — Admin SDK handles updates/deletes) ────
    match /training_backups/{backupId} {
      allow read: if isSuperAdmin();
      allow create: if isAuth()
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // ── Admin alerts (written by Cloud Functions only) ────────────────────────
    match /admin_alerts/{alertId} {
      allow read: if isSuperAdmin();
      allow create, update, delete: if false;
    }

    // ── Live locations ────────────────────────────────────────────────────────
    match /live_locations/{uid} {
      allow read: if isAuth();
      allow write: if isOwner(uid);
    }

    // ── Park presence ─────────────────────────────────────────────────────────
    match /park_presence/{communityId}/active_members/{uid} {
      allow read: if isAuth();
      allow write: if isOwner(uid);
    }

    // ── Notifications ─────────────────────────────────────────────────────────
    match /notifications/{uid} {
      match /items/{itemId} {
        allow read, delete: if isOwner(uid);
        // Any authenticated user can create, but must identify themselves
        allow create: if isAuth()
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 200
          && request.resource.data.body is string
          && request.resource.data.body.size() <= 500
          && request.resource.data.isRead == false
          && request.resource.data.createdAt == request.time;
        allow update: if isOwner(uid);
      }
    }

    // ── Training programs ──────────────────────────────────────────────────
    match /training_programs/{programId} {
      // Anyone can read published programs or their own programs
      allow read: if isAuth();
      // SuperAdmins can do anything
      allow write: if isSuperAdmin();
      // Authenticated users can create their own programs
      allow create: if isAuth()
        && request.resource.data.creatorUid == request.auth.uid;
      // Owners can update/delete their own programs
      allow update, delete: if isAuth()
        && resource.data.creatorUid == request.auth.uid;
    }

    // ── Exercise catalogue ────────────────────────────────────────────────────
    match /exercise_catalogue/{exerciseId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // ── Weekly challenges ─────────────────────────────────────────────────────
    match /weekly_challenges/{challengeId} {
      allow read: if isAuth();
      allow write: if isSuperAdmin();
    }

    // ── Park requests (user-submitted park addition requests) ─────────────────
    match /park_requests/{reqId} {
      allow read: if isSuperAdmin();
      allow create: if isAuth()
        && request.resource.data.requestedByUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 80
        && request.resource.data.createdAt == request.time
        && (!('description' in request.resource.data)
            || (request.resource.data.description is string && request.resource.data.description.size() <= 500));
      allow update, delete: if isSuperAdmin();
    }

    // ── Form check requests (coach video review) ──────────────────────────────
    match /form_check_requests/{reqId} {
      allow read: if isAuth() && (
        request.auth.uid == resource.data.userId || isSuperAdmin()
      );
      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && (!('notes' in request.resource.data)
            || (request.resource.data.notes is string && request.resource.data.notes.size() <= 1000));
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin() || request.auth.uid == resource.data.userId;
    }

    // ── Park-community association requests ───────────────────────────────────
    match /park_community_requests/{reqId} {
      allow read: if isAuth();
      allow create: if isAuth()
        && request.resource.data.communityName is string
        && request.resource.data.communityName.size() <= 80
        && request.resource.data.createdAt == request.time;
      allow update, delete: if isSuperAdmin();
    }

    // ── Community verification requests ───────────────────────────────────────
    match /verification_requests/{reqId} {
      allow read: if isAuth();
      allow create: if isAuth()
        && request.resource.data.createdAt == request.time
        && (!('reason' in request.resource.data)
            || (request.resource.data.reason is string && request.resource.data.reason.size() <= 500));
      allow update, delete: if isSuperAdmin();
    }

    // ── Battle rooms ──────────────────────────────────────────────────────────
    match /battles/{battleId} {
      allow read: if isAuth();

      allow create: if isAuth()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.status == 'LOBBY'
        && request.resource.data.createdAt == request.time
        && request.resource.data.code is string
        && request.resource.data.code.size() == 6
        && request.resource.data.maxPlayers >= 2
        && request.resource.data.maxPlayers <= 8
        && request.resource.data.playerCount == 0;

      allow update: if isAuth()
        && request.auth.uid == resource.data.hostUid
        && (
          // LOBBY → COUNTDOWN
          (resource.data.status == 'LOBBY'
            && request.resource.data.status == 'COUNTDOWN'
            && request.resource.data.startAt == request.time)
          // COUNTDOWN → ACTIVE
          || (resource.data.status == 'COUNTDOWN'
            && request.resource.data.status == 'ACTIVE')
          // ACTIVE → FINISHED
          || (resource.data.status == 'ACTIVE'
            && request.resource.data.status == 'FINISHED'
            && request.resource.data.finishedAt == request.time)
          // Any → CANCELLED
          || request.resource.data.status == 'CANCELLED'
        );

      allow delete: if false;

      match /players/{uid} {
        allow read: if isAuth();
        allow create: if (isOwner(uid)
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.reps == 0
            && request.resource.data.joinedAt == request.time)
          // Host can create bot players
          || (isAuth()
            && request.auth.uid == get(/databases/$(database)/documents/battles/$(battleId)).data.hostUid
            && uid.matches('^bot_.*')
            && request.resource.data.uid == uid
            && request.resource.data.reps == 0);
        allow update: if (isOwner(uid)
            && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['uid', 'joinedAt', 'coinsEarned']))
          // Host can update bot players (rep simulation)
          || (isAuth()
            && request.auth.uid == get(/databases/$(database)/documents/battles/$(battleId)).data.hostUid
            && uid.matches('^bot_.*'));
        allow delete: if isOwner(uid)
          // Host can delete bot players
          || (isAuth()
            && request.auth.uid == get(/databases/$(database)/documents/battles/$(battleId)).data.hostUid
            && uid.matches('^bot_.*'));
      }
    }

    // ── Battle history (under user) ──────────────────────────────────────────
    match /users/{uid}/battle_history/{battleId} {
      allow read: if isAuth();
      allow create: if isOwner(uid);
      allow update, delete: if false;
    }

    // ── Event rooms ──────────────────────────────────────────────────────────
    match /events/{eventId} {
      allow read: if isAuth() || resource.data.isPublic == true;

      allow create: if isAuth()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.status == 'LOBBY'
        && request.resource.data.createdAt == request.time
        && request.resource.data.code is string
        && request.resource.data.code.size() == 6
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 100
        && request.resource.data.maxParticipants >= 2
        && request.resource.data.maxParticipants <= 50
        && request.resource.data.participantCount == 0;

      allow update: if isAuth()
        && (
          // Host status transitions
          (request.auth.uid == resource.data.hostUid && (
            // LOBBY → COUNTDOWN
            (resource.data.status == 'LOBBY'
              && request.resource.data.status == 'COUNTDOWN'
              && request.resource.data.startedAt == request.time)
            // COUNTDOWN → ACTIVE
            || (resource.data.status == 'COUNTDOWN'
              && request.resource.data.status == 'ACTIVE')
            // ACTIVE → FINISHED
            || (resource.data.status == 'ACTIVE'
              && request.resource.data.status == 'FINISHED'
              && request.resource.data.finishedAt == request.time)
            // Any → CANCELLED
            || request.resource.data.status == 'CANCELLED'
          ))
          // Authenticated users can increment/decrement participantCount by 1 (join/leave)
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantCount'])
            && (request.resource.data.participantCount == resource.data.participantCount + 1
              || request.resource.data.participantCount == resource.data.participantCount - 1))
        );

      allow delete: if false;

      match /participants/{uid} {
        allow read: if isAuth() || get(/databases/$(database)/documents/events/$(eventId)).data.isPublic == true;
        allow create: if (isOwner(uid)
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.totalPoints == 0
            && request.resource.data.joinedAt == request.time)
          // Host can create bot participants
          || (isAuth()
            && request.auth.uid == get(/databases/$(database)/documents/events/$(eventId)).data.hostUid
            && uid.matches('^bot_.*')
            && request.resource.data.uid == uid
            && request.resource.data.totalPoints == 0);
        allow update: if (isOwner(uid)
            && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['uid', 'joinedAt']))
          // Host can update bot participants (rep simulation)
          || (isAuth()
            && request.auth.uid == get(/databases/$(database)/documents/events/$(eventId)).data.hostUid
            && uid.matches('^bot_.*'));
        allow delete: if isOwner(uid)
          // Host can delete bot participants
          || (isAuth()
            && request.auth.uid == get(/databases/$(database)/documents/events/$(eventId)).data.hostUid
            && uid.matches('^bot_.*'));
      }
    }

    // ── Event history (under user) ──────────────────────────────────────────
    match /users/{uid}/event_history/{eventId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid);
      allow update, delete: if false;
    }

    // ── Feedback (user submissions + superadmin replies) ──────────────────────
    match /feedback/{feedbackId} {
      allow read, update, delete: if isSuperAdmin();
      allow create: if isSuperAdmin() || (isAuth()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.subject is string
        && request.resource.data.subject.size() <= 150
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 2500
        && request.resource.data.createdAt == request.time);
    }
  }
}

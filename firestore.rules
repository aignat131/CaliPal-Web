rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }
    // NOTE: Hardcoded email will be replaced with a custom claim once the
    // Firebase Admin SDK is configured to set `superAdmin: true` on the token.
    // Future: `return isAuth() && request.auth.token.superAdmin == true;`
    function isSuperAdmin() {
      return isAuth() && (
        request.auth.token.email == 'aignat131@gmail.com'
        || request.auth.token.superAdmin == true
      );
    }
    function getCommunityMember(communityId) {
      return get(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid));
    }
    function isCommunityMember(communityId) {
      return isAuth() && exists(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid));
    }
    function getMemberRole(communityId) {
      return getCommunityMember(communityId).data.role;
    }
    function isCommunityAdmin(communityId) {
      return isCommunityMember(communityId) && getMemberRole(communityId) == 'ADMIN';
    }
    function isCommunityStaff(communityId) {
      return isCommunityMember(communityId) &&
        getMemberRole(communityId) in ['ADMIN', 'MODERATOR', 'TRAINER'];
    }

    // ── Users ─────────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isAuth();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) || isSuperAdmin();

      match /workouts/{workoutId} {
        allow read: if isAuth();
        allow write: if isOwner(uid);
      }
      match /skills/{skillId} {
        allow read: if isAuth();
        allow write: if isOwner(uid);
      }
      match /challenge_progress/{challengeId} {
        allow read, write: if isOwner(uid);
      }
      match /community_challenge_progress/{challengeId} {
        allow read, write: if isOwner(uid);
      }
      // Friends subcollection — any auth user can read; owner or the friend themselves can write
      match /friends/{friendId} {
        allow read: if isAuth();
        allow create: if isOwner(uid) || (isAuth() && request.auth.uid == friendId);
        allow delete: if isOwner(uid) || (isAuth() && request.auth.uid == friendId);
      }
    }

    // ── Coin tasks (one-time award guards) ────────────────────────────────────
    match /coin_tasks/{taskId} {
      allow read: if isAuth() && (resource == null || resource.data.uid == request.auth.uid);
      allow create: if isAuth() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // ── FCM tokens ────────────────────────────────────────────────────────────
    match /fcm_tokens/{uid} {
      allow read, write: if isOwner(uid);
    }

    // ── Communities ───────────────────────────────────────────────────────────
    match /communities/{communityId} {
      allow read: if true;
      allow create: if isAuth()
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 80
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 1000;
      allow update: if isCommunityAdmin(communityId) || isSuperAdmin() ||
        (isAuth() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount']));
      allow delete: if isSuperAdmin();

      match /members/{uid} {
        allow read: if isAuth();
        allow create: if isOwner(uid);
        allow update: if isOwner(uid) || isCommunityAdmin(communityId) || isSuperAdmin();
        allow delete: if isOwner(uid) || isCommunityAdmin(communityId) || isSuperAdmin();
      }

      match /posts/{postId} {
        allow read: if isAuth();
        allow create: if isCommunityMember(communityId)
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 2000;
        allow update: if isAuth() && (
          request.auth.uid == resource.data.authorId ||
          isCommunityStaff(communityId) ||
          isSuperAdmin() ||
          (isCommunityMember(communityId) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentsCount']))
        );
        allow delete: if isAuth() && (
          request.auth.uid == resource.data.authorId ||
          isCommunityStaff(communityId) ||
          isSuperAdmin()
        );

        match /comments/{commentId} {
          allow read: if isAuth();
          allow create: if isCommunityMember(communityId)
            && request.resource.data.text is string
            && request.resource.data.text.size() <= 1000;
          allow update, delete: if isAuth() && (
            request.auth.uid == resource.data.authorId ||
            isCommunityStaff(communityId) ||
            isSuperAdmin()
          );
        }

        match /likes/{uid} {
          allow read: if isAuth();
          allow write: if isOwner(uid);
        }
      }

      match /trainings/{trainingId} {
        allow read: if true;
        allow create: if (isCommunityMember(communityId) || isSuperAdmin())
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 120
          && request.resource.data.description is string
          && request.resource.data.description.size() <= 1000;
        allow delete: if isSuperAdmin()
          || isCommunityStaff(communityId)
          || (isCommunityMember(communityId) && request.auth.uid == resource.data.authorId);
        // Members: update own rsvp + rsvpNames (+ optionally lastRsvpNotifAt in same write)
        // Anyone (incl. guests): update guestRsvps (+ optionally lastRsvpNotifAt), capped at 200 entries
        allow update: if isSuperAdmin()
          || isCommunityStaff(communityId)
          || (isCommunityMember(communityId)
              && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['rsvps', 'rsvpNames', 'lastRsvpNotifAt']))
          || (request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['guestRsvps', 'lastRsvpNotifAt'])
              && request.resource.data.guestRsvps.size() <= 200);
      }

      match /challenges/{challengeId} {
        allow read: if isAuth();
        allow create: if isSuperAdmin() || isCommunityStaff(communityId);
        allow update, delete: if isSuperAdmin() || isCommunityAdmin(communityId);
      }
    }

    // ── Direct messages ───────────────────────────────────────────────────────
    match /conversations/{conversationId} {
      function isParticipant() {
        return isAuth() && resource != null && request.auth.uid in resource.data.participantIds;
      }
      allow read: if resource == null || isParticipant();
      allow create: if isAuth() && request.auth.uid in request.resource.data.participantIds;
      allow update: if isParticipant();

      match /messages/{messageId} {
        function convParticipants() {
          let conv = get(/databases/$(database)/documents/conversations/$(conversationId));
          return conv == null ? [] : conv.data.participantIds;
        }
        allow read: if isAuth() && request.auth.uid in convParticipants();
        allow create: if isAuth() &&
          request.auth.uid in convParticipants() &&
          request.auth.uid == request.resource.data.senderId &&
          request.resource.data.text is string &&
          request.resource.data.text.size() <= 4000;
        allow delete: if isAuth() && resource.data.senderId == request.auth.uid;
      }
    }

    // ── Friend requests ───────────────────────────────────────────────────────
    match /friend_requests/{requestId} {
      allow read: if isAuth() && (
        resource == null ||
        request.auth.uid == resource.data.fromUid ||
        request.auth.uid == resource.data.toUid
      );
      allow create: if isAuth() && request.auth.uid == request.resource.data.fromUid;
      allow update: if isAuth() && (
        request.auth.uid == resource.data.toUid ||
        request.auth.uid == resource.data.fromUid
      );
      allow delete: if isAuth() && (
        request.auth.uid == resource.data.fromUid ||
        request.auth.uid == resource.data.toUid
      );
    }

    // ── Skill category definitions ────────────────────────────────────────────
    match /skillCategories/{categoryId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // ── Parks ─────────────────────────────────────────────────────────────────
    match /parks/{parkId} {
      allow read: if true;
      allow create, delete: if isSuperAdmin();
      allow update: if isSuperAdmin()
        || (isAuth() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['communityId']))
        || (isAuth() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upcomingTrainingCount']));

      match /trainings/{trainingId} {
        allow read: if true;
        allow create: if isAuth()
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 120
          && request.resource.data.description is string
          && request.resource.data.description.size() <= 1000;
        allow delete: if isSuperAdmin()
          || (isAuth() && request.auth.uid == resource.data.authorId);
        // Authenticated users: update own rsvp + rsvpNames (+ optionally lastRsvpNotifAt)
        // Anyone (incl. guests): update guestRsvps (+ optionally lastRsvpNotifAt), capped at 200
        // Author: update anything
        allow update: if isSuperAdmin()
          || (isAuth() && request.auth.uid == resource.data.authorId)
          || (isAuth()
              && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['rsvps', 'rsvpNames', 'lastRsvpNotifAt']))
          || (request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['guestRsvps', 'lastRsvpNotifAt'])
              && request.resource.data.guestRsvps.size() <= 200);
      }
    }

    // ── Live locations ────────────────────────────────────────────────────────
    match /live_locations/{uid} {
      allow read: if isAuth();
      allow write: if isOwner(uid);
    }

    // ── Park presence ─────────────────────────────────────────────────────────
    match /park_presence/{communityId}/active_members/{uid} {
      allow read: if isAuth();
      allow write: if isOwner(uid);
    }

    // ── Notifications ─────────────────────────────────────────────────────────
    match /notifications/{uid} {
      match /items/{itemId} {
        allow read, delete: if isOwner(uid);
        allow create: if isAuth();
        allow update: if isOwner(uid);
      }
    }

    // ── Exercise catalogue ────────────────────────────────────────────────────
    match /exercise_catalogue/{exerciseId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // ── Weekly challenges ─────────────────────────────────────────────────────
    match /weekly_challenges/{challengeId} {
      allow read: if isAuth();
      allow write: if isSuperAdmin();
    }

    // ── Park requests (user-submitted park addition requests) ─────────────────
    match /park_requests/{reqId} {
      allow read: if isSuperAdmin();
      allow create: if isAuth() && request.resource.data.requestedByUid == request.auth.uid;
      allow update, delete: if isSuperAdmin();
    }

    // ── Form check requests (coach video review) ──────────────────────────────
    match /form_check_requests/{reqId} {
      allow read: if isAuth() && (
        request.auth.uid == resource.data.userId || isSuperAdmin()
      );
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin() || request.auth.uid == resource.data.userId;
    }

    // ── Park-community association requests ───────────────────────────────────
    match /park_community_requests/{reqId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update, delete: if isSuperAdmin();
    }

    // ── Community verification requests ───────────────────────────────────────
    match /verification_requests/{reqId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update, delete: if isSuperAdmin();
    }
  }
}

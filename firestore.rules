rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }
    function isSuperAdmin() {
      return isAuth() && request.auth.token.superAdmin == true;
    }
    function getCommunityMember(communityId) {
      return get(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid));
    }
    function isCommunityMember(communityId) {
      return isAuth() && exists(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid));
    }
    function getMemberRole(communityId) {
      return getCommunityMember(communityId).data.role;
    }
    function isCommunityAdmin(communityId) {
      return isCommunityMember(communityId) && getMemberRole(communityId) == 'ADMIN';
    }
    function isCommunityStaff(communityId) {
      return isCommunityMember(communityId) &&
        getMemberRole(communityId) in ['ADMIN', 'MODERATOR', 'TRAINER'];
    }

    // ── Users ─────────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isAuth();
      allow create: if isOwner(uid)
        && request.resource.data.createdAt == request.time;
      allow update: if (isOwner(uid)
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['bio'])
              || (request.resource.data.bio is string && request.resource.data.bio.size() <= 500))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['displayName'])
              || (request.resource.data.displayName is string && request.resource.data.displayName.size() <= 60))
        ) || isSuperAdmin()
        // Allow any authenticated user to increment totalTrainings (used when closing a training)
        || (isAuth() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalTrainings']));

      match /workouts/{workoutId} {
        allow read: if isAuth();
        allow write: if isOwner(uid);
      }
      match /skills/{skillId} {
        allow read: if isAuth();
        allow write: if isOwner(uid);
      }
      match /challenge_progress/{challengeId} {
        allow read, write: if isOwner(uid);
      }
      match /community_challenge_progress/{challengeId} {
        allow read, write: if isOwner(uid);
      }
      // Friends subcollection — any auth user can read; owner or the friend themselves can write
      match /friends/{friendId} {
        allow read: if isAuth();
        allow create: if isOwner(uid) || (isAuth() && request.auth.uid == friendId);
        allow delete: if isOwner(uid) || (isAuth() && request.auth.uid == friendId);
      }
    }

    // ── Shop purchases ────────────────────────────────────────────────────────
    match /users/{uid}/purchases/{itemId} {
      allow read: if isAuth();
      allow create: if isOwner(uid);
      allow update, delete: if false;
    }

    // ── Coin tasks (one-time award guards) ────────────────────────────────────
    match /coin_tasks/{taskId} {
      allow read: if isAuth() && (resource == null || resource.data.uid == request.auth.uid);
      allow create: if isAuth()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.awardedAt == request.time;
      allow update, delete: if false;
    }

    // ── Training streak milestone guards ──────────────────────────────────────
    match /training_streak_tasks/{taskId} {
      allow read: if isAuth() && (resource == null || resource.data.uid == request.auth.uid);
      allow create: if isAuth()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.awardedAt == request.time;
      allow update, delete: if false;
    }

    // ── Push / email rate limiting (server-only write via Admin SDK) ─────────
    match /push_rate/{uid} {
      allow read, write: if false; // admin SDK only
    }
    match /email_rate/{uid} {
      allow read, write: if false; // admin SDK only
    }

    // ── FCM tokens ────────────────────────────────────────────────────────────
    match /fcm_tokens/{uid} {
      allow read, write: if isOwner(uid);
    }

    // ── Communities ───────────────────────────────────────────────────────────
    match /communities/{communityId} {
      allow read: if true;
      allow create: if isAuth()
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 80
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 1000
        && request.resource.data.createdAt == request.time
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.joinedCommunityIds.size() < 10;
      allow update: if isCommunityAdmin(communityId) || isSuperAdmin() ||
        (isAuth() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount']));
      allow delete: if isSuperAdmin();

      match /members/{uid} {
        allow read: if true;
        allow create: if isOwner(uid)
          && request.resource.data.joinedAt == request.time;
        allow update: if isOwner(uid) || isCommunityStaff(communityId) || isSuperAdmin();
        allow delete: if isOwner(uid) || isCommunityAdmin(communityId) || isSuperAdmin();
      }

      match /posts/{postId} {
        allow read: if isAuth();
        allow create: if isCommunityMember(communityId)
          && request.resource.data.content is string
          && request.resource.data.content.size() <= 2000
          && request.resource.data.createdAt == request.time;
        allow update: if isAuth() && (
          request.auth.uid == resource.data.authorId ||
          isCommunityStaff(communityId) ||
          isSuperAdmin() ||
          (isCommunityMember(communityId) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentsCount']))
        );
        allow delete: if isAuth() && (
          request.auth.uid == resource.data.authorId ||
          isCommunityStaff(communityId) ||
          isSuperAdmin()
        );

        match /comments/{commentId} {
          allow read: if isAuth();
          allow create: if isCommunityMember(communityId)
            && request.resource.data.text is string
            && request.resource.data.text.size() <= 1000
            && request.resource.data.createdAt == request.time;
          allow update, delete: if isAuth() && (
            request.auth.uid == resource.data.authorId ||
            isCommunityStaff(communityId) ||
            isSuperAdmin()
          );
        }

        match /likes/{uid} {
          allow read: if isAuth();
          allow write: if isOwner(uid);
        }

        match /reactions/{uid} {
          allow read: if isAuth();
          allow write: if isOwner(uid);
        }
      }

      match /trainings/{trainingId} {
        allow read: if true;
        allow create: if (isCommunityMember(communityId) || isSuperAdmin())
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 120
          && request.resource.data.description is string
          && request.resource.data.description.size() <= 1000
          && request.resource.data.createdAt == request.time;
        // Hard delete blocked — only Admin SDK (server-side) can delete
        allow delete: if false;
        // Staff: close training and mark attendees
        // Author: edit own training details
        // Members: update own rsvp + rsvpNames (+ optionally lastRsvpNotifAt in same write)
        // Anyone (incl. guests): update guestRsvps (+ optionally lastRsvpNotifAt), capped at 200
        // NOTE: deletedAt/deletedByUid blocked from ALL clients — soft-delete only via API
        allow update: if (isSuperAdmin()
              && !request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(['deletedAt', 'deletedByUid']))
          || (isCommunityStaff(communityId)
              && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['isClosed', 'attendedBy', 'closedAt', 'closedByUid']))
          || (isCommunityMember(communityId)
              && request.auth.uid == resource.data.authorId
              && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['name', 'description', 'timeStart', 'timeEnd']))
          || (isCommunityMember(communityId)
              && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['rsvps', 'rsvpNames', 'rsvpPhotos', 'lastRsvpNotifAt']))
          || (isCommunityMember(communityId)
              && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['photoCount', 'commentsCount']))
          || (request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['guestRsvps', 'lastRsvpNotifAt'])
              && request.resource.data.guestRsvps.size() <= 200);
      }

      // Training photos — one per attendee
      match /trainings/{trainingId}/photos/{photoId} {
        allow read: if isAuth() && (
          !('visibility' in resource.data)
          || resource.data.visibility == 'public'
          || request.auth.uid == resource.data.authorId
          || isSuperAdmin()
        );
        allow create: if isCommunityMember(communityId)
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.photoUrl is string
          && request.resource.data.createdAt == request.time;
        allow delete: if isAuth() && (
          request.auth.uid == resource.data.authorId
          || isCommunityStaff(communityId)
          || isSuperAdmin()
        );
        allow update: if false;
      }

      // Training comments — community members can comment
      match /trainings/{trainingId}/comments/{commentId} {
        allow read: if isAuth();
        allow create: if isCommunityMember(communityId)
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 1000
          && request.resource.data.createdAt == request.time;
        allow update, delete: if isAuth() && (
          request.auth.uid == resource.data.authorId ||
          isCommunityStaff(communityId) ||
          isSuperAdmin()
        );
      }

      // Immutable mirror of trainings — no updates, no deletes from any client
      match /trainings_safe/{trainingId} {
        allow read: if true;
        allow create: if (isCommunityMember(communityId) || isSuperAdmin())
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 120
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }

      match /challenges/{challengeId} {
        allow read: if isAuth();
        allow create: if isSuperAdmin() || isCommunityStaff(communityId);
        allow update, delete: if isSuperAdmin() || isCommunityAdmin(communityId);
      }
    }

    // ── Direct messages ───────────────────────────────────────────────────────
    match /conversations/{conversationId} {
      function isParticipant() {
        return isAuth() && resource != null && request.auth.uid in resource.data.participantIds;
      }
      allow read: if resource == null || isParticipant();
      allow create: if isAuth()
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.lastMessageTimestamp == request.time;
      allow update: if isParticipant();

      match /messages/{messageId} {
        function convParticipants() {
          let conv = get(/databases/$(database)/documents/conversations/$(conversationId));
          return conv == null ? [] : conv.data.participantIds;
        }
        allow read: if isAuth() && request.auth.uid in convParticipants();
        allow create: if isAuth() &&
          request.auth.uid in convParticipants() &&
          request.auth.uid == request.resource.data.senderId &&
          request.resource.data.text is string &&
          request.resource.data.text.size() <= 4000 &&
          request.resource.data.timestamp == request.time;
        allow delete: if isAuth() && resource.data.senderId == request.auth.uid;
      }
    }

    // ── Friend requests ───────────────────────────────────────────────────────
    match /friend_requests/{requestId} {
      allow read: if isAuth() && (
        resource == null ||
        request.auth.uid == resource.data.fromUid ||
        request.auth.uid == resource.data.toUid
      );
      allow create: if isAuth()
        && request.auth.uid == request.resource.data.fromUid
        && request.resource.data.sentAt == request.time;
      allow update: if isAuth() && (
        request.auth.uid == resource.data.toUid ||
        request.auth.uid == resource.data.fromUid
      );
      allow delete: if isAuth() && (
        request.auth.uid == resource.data.fromUid ||
        request.auth.uid == resource.data.toUid
      );
    }

    // ── Skill category definitions ────────────────────────────────────────────
    match /skillCategories/{categoryId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // ── Parks ─────────────────────────────────────────────────────────────────
    match /parks/{parkId} {
      allow read: if true;
      allow create, delete: if isSuperAdmin();
      allow update: if isSuperAdmin()
        || (isAuth() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['communityId']))
        || (isAuth() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upcomingTrainingCount']));

      match /trainings/{trainingId} {
        allow read: if true;
        allow create: if isAuth()
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 120
          && request.resource.data.description is string
          && request.resource.data.description.size() <= 1000
          && request.resource.data.createdAt == request.time;
        // Hard delete blocked — only Admin SDK (server-side) can delete
        allow delete: if false;
        // NOTE: deletedAt/deletedByUid blocked from ALL clients — soft-delete only via API
        allow update: if (isSuperAdmin()
              && !request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(['deletedAt', 'deletedByUid']))
          || (isAuth() && request.auth.uid == resource.data.authorId
              && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['name', 'description', 'timeStart', 'timeEnd',
                            'rsvps', 'rsvpNames', 'rsvpPhotos', 'lastRsvpNotifAt']))
          || (isAuth()
              && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['rsvps', 'rsvpNames', 'rsvpPhotos', 'lastRsvpNotifAt']))
          || (request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['guestRsvps', 'lastRsvpNotifAt'])
              && request.resource.data.guestRsvps.size() <= 200);
      }

      // Immutable mirror of trainings — no updates, no deletes from any client
      match /trainings_safe/{trainingId} {
        allow read: if true;
        allow create: if isAuth()
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 120
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    // ── Training backups (safety net — Admin SDK handles updates/deletes) ────
    match /training_backups/{backupId} {
      allow read: if isSuperAdmin();
      allow create: if isAuth()
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // ── Admin alerts (written by Cloud Functions only) ────────────────────────
    match /admin_alerts/{alertId} {
      allow read: if isSuperAdmin();
      allow create, update, delete: if false;
    }

    // ── Live locations ────────────────────────────────────────────────────────
    match /live_locations/{uid} {
      allow read: if isAuth();
      allow write: if isOwner(uid);
    }

    // ── Park presence ─────────────────────────────────────────────────────────
    match /park_presence/{communityId}/active_members/{uid} {
      allow read: if isAuth();
      allow write: if isOwner(uid);
    }

    // ── Notifications ─────────────────────────────────────────────────────────
    match /notifications/{uid} {
      match /items/{itemId} {
        allow read, delete: if isOwner(uid);
        allow create: if isAuth()
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 200
          && request.resource.data.body is string
          && request.resource.data.body.size() <= 500
          && request.resource.data.isRead == false
          && request.resource.data.createdAt == request.time;
        allow update: if isOwner(uid);
      }
    }

    // ── Exercise catalogue ────────────────────────────────────────────────────
    match /exercise_catalogue/{exerciseId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // ── Weekly challenges ─────────────────────────────────────────────────────
    match /weekly_challenges/{challengeId} {
      allow read: if isAuth();
      allow write: if isSuperAdmin();
    }

    // ── Park requests (user-submitted park addition requests) ─────────────────
    match /park_requests/{reqId} {
      allow read: if isSuperAdmin();
      allow create: if isAuth()
        && request.resource.data.requestedByUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 80
        && request.resource.data.createdAt == request.time
        && (!('description' in request.resource.data)
            || (request.resource.data.description is string && request.resource.data.description.size() <= 500));
      allow update, delete: if isSuperAdmin();
    }

    // ── Form check requests (coach video review) ──────────────────────────────
    match /form_check_requests/{reqId} {
      allow read: if isAuth() && (
        request.auth.uid == resource.data.userId || isSuperAdmin()
      );
      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && (!('notes' in request.resource.data)
            || (request.resource.data.notes is string && request.resource.data.notes.size() <= 1000));
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin() || request.auth.uid == resource.data.userId;
    }

    // ── Park-community association requests ───────────────────────────────────
    match /park_community_requests/{reqId} {
      allow read: if isAuth();
      allow create: if isAuth()
        && request.resource.data.communityName is string
        && request.resource.data.communityName.size() <= 80
        && request.resource.data.createdAt == request.time;
      allow update, delete: if isSuperAdmin();
    }

    // ── Community verification requests ───────────────────────────────────────
    match /verification_requests/{reqId} {
      allow read: if isAuth();
      allow create: if isAuth()
        && request.resource.data.createdAt == request.time
        && (!('reason' in request.resource.data)
            || (request.resource.data.reason is string && request.resource.data.reason.size() <= 500));
      allow update, delete: if isSuperAdmin();
    }

    // ── Feedback (user submissions + superadmin replies) ──────────────────────
    match /feedback/{feedbackId} {
      allow read, update, delete: if isSuperAdmin();
      allow create: if isSuperAdmin() || (isAuth()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.subject is string
        && request.resource.data.subject.size() <= 150
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 2500
        && request.resource.data.createdAt == request.time);
    }
  }
}

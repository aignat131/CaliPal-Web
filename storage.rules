rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuth() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }
    // Check if the requesting user is an admin or moderator of this community
    function isCommunityAdmin(communityId) {
      let member = firestore.get(/databases/(default)/documents/communities/$(communityId)/members/$(request.auth.uid));
      return isAuth() && member != null && member.data.role in ['ADMIN', 'MODERATOR'];
    }

    // Profile photos — owner writes, any auth user reads
    match /profile_photos/{uid}/{allPaths=**} {
      allow read: if isAuth();
      allow write: if isOwner(uid);
    }

    // Community photos — only community admins/moderators can write
    match /community_photos/{communityId}/{allPaths=**} {
      allow read: if true;
      allow write: if isCommunityAdmin(communityId);
    }

    // Workout photos — owner writes and reads, any auth user can read
    match /workout_photos/{uid}/{allPaths=**} {
      allow read: if isAuth();
      allow write: if isOwner(uid);
    }
  }
}

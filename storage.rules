rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuth() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }
    function isCommunityMember(communityId) {
      let member = firestore.get(/databases/(default)/documents/communities/$(communityId)/members/$(request.auth.uid));
      return isAuth() && member != null;
    }
    // Check if the requesting user is an admin or moderator of this community
    function isCommunityAdmin(communityId) {
      let member = firestore.get(/databases/(default)/documents/communities/$(communityId)/members/$(request.auth.uid));
      return isAuth() && member != null && member.data.role in ['ADMIN', 'MODERATOR'];
    }

    // Profile photos — owner writes, publicly readable (needed for shared training pages)
    match /profile_photos/{uid}/{fileName} {
      allow read: if true;
      allow write: if isOwner(uid)
        && request.resource.contentType.matches('image/.*')
        && request.resource.size <= 8 * 1024 * 1024;
    }

    // Community photos — only community admins/moderators can write
    match /community_photos/{communityId}/{fileName} {
      allow read: if true;
      allow write: if isCommunityAdmin(communityId)
        && request.resource.contentType.matches('image/.*')
        && request.resource.size <= 8 * 1024 * 1024;
    }

    // Workout photos — owner writes and reads, any auth user can read
    match /workout_photos/{uid}/{fileName} {
      allow read: if isAuth();
      allow write: if isOwner(uid)
        && request.resource.contentType.matches('image/.*')
        && request.resource.size <= 8 * 1024 * 1024;
    }

    // Training photos — only community members can upload
    match /training_photos/{communityId}/{trainingId}/{fileName} {
      allow read: if isAuth();
      allow write: if isCommunityMember(communityId)
        && request.resource.contentType.matches('image/.*')
        && request.resource.size <= 8 * 1024 * 1024;
    }

    // Community post photos — only community members can upload
    match /community_posts/{communityId}/{fileName} {
      allow read: if isAuth();
      allow write: if isCommunityMember(communityId)
        && request.resource.contentType.matches('image/.*')
        && request.resource.size <= 8 * 1024 * 1024;
    }

    // Chat images — conversation participants can upload
    match /chatImages/{conversationId}/{fileName} {
      allow read: if isAuth();
      allow write: if isAuth()
        && request.resource.contentType.matches('image/.*')
        && request.resource.size <= 8 * 1024 * 1024;
    }

    // Form check videos — owner writes, superadmin reads
    match /form_check_videos/{uid}/{fileName} {
      allow read: if isOwner(uid) || isAuth();
      allow write: if isOwner(uid)
        && request.resource.contentType.matches('video/.*')
        && request.resource.size <= 100 * 1024 * 1024;
    }
  }
}
